# ==============================================================================
# Portfolio & Toolyard Production Environment Configuration
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# DO NOT commit real secrets or production credentials to version control.
# ==============================================================================

# Node / Server Configuration
PORT=3000
NODE_ENV=development

# Session & Token Security (HMAC-SHA256 Signing Key)
# Generate a strong 64-char hex key: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your_random_64_character_hex_secret_here

# Administrative Authentication
# Plaintext password (for initial setup) or PBKDF2 hash (recommended)
# Generate hash via: node -e "const s = require('./api/utils/security'); console.log(s.hashPassword('your_secure_password'))"
ADMIN_PASSWORD=your_secure_admin_password_here
# Optional: Pre-hashed password for zero plain-text storage
ADMIN_PASSWORD_HASH=pbkdf2:100000:salt_hex:hash_hex

# Vault (NDA Client Clearance) Passcode
VAULT_PASSCODE=your_confidential_vault_passcode_here

# Cloudinary Storage & Media Delivery
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Supabase (PostgreSQL & Row Level Security)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_server_only
